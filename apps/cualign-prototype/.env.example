# build.nvidia.com > Settings > API Keys. Only in .env (gitignored). Never commit or log.
NVIDIA_API_KEY=nvapi-
# NAT CLI usage telemetry stays off (cualign serve sets this too)
NAT_TELEMETRY_ENABLED=0
# Guardrails: 0 turns them off (logged at ERROR). CUALIGN_RAILS_FAIL_CLOSED=1 refuses a turn when a rail errors
# and stops startup when there is no key. An explicit CUALIGN_GUARDRAILS=0 still turns them off.
# CUALIGN_GUARDRAILS=1
# CUALIGN_RAILS_FAIL_CLOSED=
# Optional: folder with per-tooth STL files (2.stl ... 15.stl, Universal numbering, upper arch)
# CUALIGN_CASE_DIR=
# Optional: ToothGroupNetwork checkout for scan segmentation (see docs/segmentation.md)
# CUALIGN_TGN_DIR=
